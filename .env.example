# =====================================================================
#  KONFIGURASI WEBSITE HANS PROJECT
#  Salin file ini menjadi ".env" lalu isi nilainya.
#  install.bat / setup-dev.bat otomatis membuat .env dan mengisi
#  SECRET_KEY serta ADMIN_URL_PATH dengan nilai acak.
#
#  File .env berisi RAHASIA. Jangan dibagikan dan jangan masuk git.
#  Baris yang diawali # adalah komentar (tidak dibaca).
# =====================================================================

# --- Mode ------------------------------------------------------------
# production  = server sungguhan (wajib HTTPS, menolak setelan berbahaya)
# development = komputer pengembangan
APP_ENV=production

# Kunci rahasia acak (minimal 50 karakter). Dibuat otomatis oleh install.bat.
# Jika diganti, semua admin harus login ulang.
SECRET_KEY=

# Mode debug. Di server WAJIB false (website menolak berjalan bila true).
DEBUG=false

# --- Alamat website --------------------------------------------------
# Nama domain yang diizinkan, dipisah koma.
ALLOWED_HOSTS=hansproject.app,www.hansproject.app
# Alamat utama website (dipakai untuk SEO, sitemap, dan link berbagi).
SITE_URL=https://hansproject.app
# Domain untuk alamat toko aplikasi kasir: <nama>.STORE_BASE_DOMAIN.
# Semua subdomain toko otomatis diizinkan (tidak perlu ditulis di ALLOWED_HOSTS).
# Komputer pengembangan: kosongkan (otomatis "localhost" -> http://<nama>.localhost:8432).
STORE_BASE_DOMAIN=hansproject.app

# --- Panel pengelola (admin) -----------------------------------------
# Bagian alamat panel: https://hansproject.app/<ADMIN_URL_PATH>/
# Jangan pakai kata yang mudah ditebak seperti "admin". Dibuat acak oleh install.bat.
ADMIN_URL_PATH=ganti-alamat-panel-ini
# Wajibkan verifikasi dua langkah (2FA) untuk admin. Sangat disarankan: true.
ADMIN_REQUIRE_2FA=true
# Admin otomatis keluar setelah sekian menit tidak ada aktivitas.
ADMIN_SESSION_MINUTES=30
# Batas maksimal satu sesi login (jam), walaupun aktif terus.
ADMIN_SESSION_MAX_HOURS=12
# Setelah gagal login sekian kali, akun/perangkat dikunci sementara (menit).
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# --- Akun pelanggan: Daftar / Masuk dengan Google -------------------
# Dibuat di Google Cloud Console > Google Auth Platform > Clients (lihat README).
# Client Secret itu RAHASIA, sama seperti password.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Kosongkan = otomatis SITE_URL + /akun/google/callback/
# Harus SAMA PERSIS dengan "Authorized redirect URIs" di Google Cloud Console.
GOOGLE_REDIRECT_URI=
# Pelanggan tetap login selama sekian hari sejak terakhir aktif.
MEMBER_SESSION_DAYS=30

# --- Database MariaDB ------------------------------------------------
# Server MariaDB di komputer yang sama. Port bawaan proyek ini 3307.
DB_HOST=127.0.0.1
DB_PORT=3307
# Nama database khusus website ini. Semua tabel memakai awalan "hp_",
# jadi aman walaupun database sudah berisi tabel lain.
DB_NAME=hansproject_web
# User database KHUSUS aplikasi (BUKAN root). Dibuat oleh scripts\db_setup.py.
DB_USER=hansproject_app
DB_PASSWORD=
# Folder program MariaDB (untuk backup/restore). Kosongkan = dicari otomatis.
# Contoh: C:\Program Files\MariaDB 11.4\bin
MARIADB_BIN_DIR=

# --- Waktu -----------------------------------------------------------
TIME_ZONE=Asia/Makassar

# --- Server aplikasi (Waitress) --------------------------------------
# Website hanya mendengarkan di komputer ini (127.0.0.1). Pengunjung masuk
# lewat reverse proxy (Caddy) yang menangani HTTPS.
SERVER_HOST=127.0.0.1
SERVER_PORT=8432
SERVER_THREADS=8
# Alamat reverse proxy yang dipercaya untuk header X-Forwarded-*.
TRUSTED_PROXY=127.0.0.1
# Arahkan HTTP ke HTTPS dan aktifkan HSTS (detik). Biarkan seperti ini.
SECURE_SSL_REDIRECT=true
HSTS_SECONDS=31536000

# --- Folder kerja (relatif terhadap folder proyek) -------------------
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_TO_FILE=true
BACKUP_DIR=backups
# Jumlah file backup yang disimpan, dan umur maksimal backup (hari).
BACKUP_KEEP=14
BACKUP_MAX_DAYS=60
MEDIA_DIR=media
# File PRIBADI pelanggan (foto bukti bayar). Tidak bisa dibuka publik.
# Ikut dibackup terpisah (lihat README).
PRIVATE_MEDIA_DIR=private

# Lama halaman publik disimpan di memori (detik). Otomatis diperbarui
# saat data diubah di panel.
PAGE_CACHE_SECONDS=600
